VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: makes Jira ticket IDs clickable, e.g. https://acme.atlassian.net
VITE_JIRA_BASE_URL=

# Optional: your Google Workspace domain, e.g. yourcompany.com. Narrows Google's
# account chooser on the login page; who gets in is decided by who has an account.
VITE_GOOGLE_DOMAIN=
