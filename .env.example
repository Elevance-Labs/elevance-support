VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: makes Jira ticket IDs clickable, e.g. https://acme.atlassian.net
VITE_JIRA_BASE_URL=

# Optional: your Google Workspace domain, e.g. yourcompany.com. Narrows Google's
# account chooser on the login page; who gets in is decided by who has an account.
VITE_GOOGLE_DOMAIN=

# Optional: turns on notifications on devices (Web Push). The VAPID public key
# from `npm run vapid-keys`; push-send holds the matching private key. Unset, the
# bell still works and device notifications say they are not set up.
VITE_VAPID_PUBLIC_KEY=

# Optional: where the sibling apps live, for the app switcher. Unset, each is the
# folder beside this app (../elevance-work/, ../elevance-support/, ../elevance-people/).
VITE_SUITE_WORK_URL=
VITE_SUITE_SUPPORT_URL=
VITE_SUITE_PEOPLE_URL=
